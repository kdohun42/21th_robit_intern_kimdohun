<?xml version="1.0"?>

<?xml-model
    href="http://download.ros.org/schema/package_format3.xsd"
    schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>qt_project_pkg</name>

  <version>0.1.0</version>

  <description>
    ROS2 Qt zombie survival game project
  </description>

  <maintainer email="author@mail.com">
    author
  </maintainer>

  <license>BSD</license>


  <!-- 빌드 시스템 -->

  <buildtool_depend>
    ament_cmake
  </buildtool_depend>


  <!-- ROS2 -->

<depend>rclcpp</depend>
<depend>std_msgs</depend>
<depend>std_srvs</depend>


  <!-- Boost -->

  <depend>
    boost
  </depend>


  <!-- Qt5 -->

  <depend>
    qtbase5-dev
  </depend>


  <!-- 테스트 -->

  <test_depend>
    ament_lint_auto
  </test_depend>

  <test_depend>
    ament_lint_common
  </test_depend>


  <export>

    <build_type>
      ament_cmake
    </build_type>

  </export>

</package>